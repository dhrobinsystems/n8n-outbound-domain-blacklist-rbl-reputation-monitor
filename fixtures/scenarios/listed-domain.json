{
  "name": "listed-domain",
  "description": "One sending domain is listed on the domain blocklist. Dry-run records the pauses it would make.",
  "env": {
    "DRY_RUN": "true",
    "SANDBOX_MODE": "true",
    "MONITORED_DOMAINS": "send-1.outbound-pool.example,send-2.outbound-pool.example",
    "MONITORED_IPS": "192.0.2.10,198.51.100.20",
    "CAMPAIGN_MAP": {
      "send-1.outbound-pool.example": {
        "smartlead": [
          "zzz_TEST_sl_1001"
        ],
        "instantly": [
          "zzz_TEST_inst_2001"
        ]
      },
      "192.0.2.10": {
        "smartlead": [
          "zzz_TEST_sl_1002",
          "zzz_TEST_sl_1001"
        ],
        "instantly": [
          "zzz_TEST_inst_2002"
        ]
      }
    }
  },
  "dns": {
    "send-1.outbound-pool.example.dbl.spamhaus.org": [
      "127.0.1.2"
    ]
  },
  "dnsDefault": "ENOTFOUND",
  "expect": {
    "mode": "DRY_RUN",
    "verdicts": {
      "send-1.outbound-pool.example": "listed",
      "send-2.outbound-pool.example": "clean",
      "192.0.2.10": "clean",
      "198.51.100.20": "clean"
    },
    "actions": {
      "smartlead:zzz_TEST_sl_1001": "dry_run",
      "instantly:zzz_TEST_inst_2001": "dry_run"
    },
    "httpCalls": 0
  }
}
