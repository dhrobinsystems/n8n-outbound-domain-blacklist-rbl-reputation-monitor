# n8n-outbound-domain-blacklist-rbl-reputation-monitor
# Copy to .env for the local mirror, or set these on your n8n host.
# Every value below is a safe placeholder. Never commit a real .env file.

# ---------------------------------------------------------------
# Safety switches
# ---------------------------------------------------------------
# Campaigns are only paused when BOTH of these are false.
# Leave both true while you test.
DRY_RUN=true
SANDBOX_MODE=true

# ---------------------------------------------------------------
# What to monitor
# ---------------------------------------------------------------
# Comma separated. Use isolated secondary sending domains, not your primary root domain.
MONITORED_DOMAINS=send-1.outbound-pool.example,send-2.outbound-pool.example
# Comma separated IPv4 addresses of dedicated sending IPs.
MONITORED_IPS=192.0.2.10,198.51.100.20
# Domains listed here are monitored and reported but NEVER auto-paused (alert only).
PRIMARY_DOMAINS=

# ---------------------------------------------------------------
# Blacklist zones
# ---------------------------------------------------------------
# Format: [alias=]zone[:ip|:domain]   (type defaults to ip)
# Leave empty to use the defaults:
#   spamhaus_zen=zen.spamhaus.org:ip
#   spamhaus_dbl=dbl.spamhaus.org:domain
#   barracuda=b.barracudacentral.org:ip
#   sorbs=dnsbl.sorbs.net:ip
# Use an alias for any zone whose name embeds a secret key so the key never reaches audit output.
RBL_ZONES=
# Optional: trigger only when at least this many zones list a target.
MIN_LISTED_ZONES=1

# ---------------------------------------------------------------
# Campaign mapping (JSON on one line)
# ---------------------------------------------------------------
# Key = a monitored domain or IP. Values = campaign IDs to pause when that target is listed.
CAMPAIGN_MAP={"send-1.outbound-pool.example":{"smartlead":["zzz_TEST_sl_1001"],"instantly":["zzz_TEST_inst_2001"]},"192.0.2.10":{"smartlead":["zzz_TEST_sl_1002"]}}
# Which platforms may be paused: smartlead, instantly
PAUSE_PLATFORMS=smartlead,instantly
# Optional staged rollout guard: only campaign IDs starting with this prefix can be paused.
PAUSE_ID_PREFIX_ALLOW=
# Circuit breaker: if more campaigns than this would be paused in one run, pause none.
MAX_PAUSES_PER_RUN=10

# ---------------------------------------------------------------
# API credentials (only needed when running live)
# ---------------------------------------------------------------
SMARTLEAD_API_KEY=replace_with_your_smartlead_api_key
INSTANTLY_API_KEY=replace_with_your_instantly_api_key
# Optional base URL overrides (https origins only)
SMARTLEAD_BASE_URL=https://server.smartlead.ai
INSTANTLY_BASE_URL=https://api.instantly.ai

# ---------------------------------------------------------------
# DNS and HTTP tuning
# ---------------------------------------------------------------
# Strongly recommended: your own recursive resolver. RBLs often refuse public resolvers.
DNS_SERVERS=198.51.100.53
DNS_TIMEOUT_MS=4000
DNS_CONCURRENCY=10
HTTP_MAX_RETRIES=3
HTTP_RETRY_BASE_MS=1000
HTTP_TIMEOUT_MS=15000
